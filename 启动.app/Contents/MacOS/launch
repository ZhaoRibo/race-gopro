#!/bin/sh
# 双击「启动.app」真正执行的就是这个脚本。
#
# 为什么用 .app 而不是 .command —— 踩过的坑，别再改回去：
#
# .command 是让「终端」开个窗口、用你的**登录 shell**把文件路径"敲"进去执行。
# 而 oh-my-zsh 启动时会打印
#     [oh-my-zsh] Would you like to update? [Y/n]
# 并用 read -k 1 读**一个字符**。两个东西撞在一起：那句提示把路径开头的 `/`
# 当成自己的回答吃掉了，剩下的 `Users/zhaoruibo/...` 成了相对路径，
# 于是报 `zsh: no such file or directory: Users/...`。
# （实测复现：`open -a Terminal 启动.command` 必现，和双击等价。）
#
# .app 由系统（LaunchServices）直接执行这个文件，不经过终端、不经过 zsh、
# 没有任何交互 —— 没这个问题，顺带也没有多余的终端窗口了。
#
# 日志写在仓库根的 .race-gopro.log；出问题会弹对话框告诉你。

set -u

# 启动.app/Contents/MacOS → 上三级就是仓库根
here=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P) || exit 1
cd "$here" || exit 1

name="卡丁车遥测分析"
log="$here/.race-gopro.log"

# 先把"被调起"记下来（含 PATH）。这一步放在所有检查之前是有意的：
# 万一后面哪一步没过、屏幕上只弹了个框，日志里也得留得下线索 ——
# 排查"双击没反应"时，第一句话就是"脚本到底跑起来没有"。
{
  echo "──────────────────────────────────────────────"
  echo "被调起：$(date '+%Y-%m-%d %H:%M:%S')"
  echo "仓库目录：$here"
  echo "PATH（进来的）：$PATH"
} >>"$log"

# 关键：GUI 启动的程序拿到的是系统默认 PATH（/usr/bin:/bin:/usr/sbin:/sbin），
# 里面**没有 Homebrew** —— 那是 shell 的 rc 文件加的，而 .app 根本不经过 shell。
# 而 ffmpeg/ffprobe 就装在 Homebrew 里，不补上这句就会误报"没装 ffmpeg"。
# 后面的 python 也靠 PATH 找这两个程序，所以得 export 出去。
PATH="/opt/homebrew/bin:/usr/local/bin:/opt/local/bin:$HOME/.local/bin:$PATH"
export PATH

# 弹个对话框告诉用户出事了，同时把同一句话写进日志
say() {
  printf '\n%s\n' "$1" >>"$log"
  /usr/bin/osascript -e \
    "display dialog \"$(printf '%s' "$1" | /usr/bin/sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')\" \
buttons {\"好\"} default button 1 with title \"$name\" with icon caution" >/dev/null 2>&1
}

if [ ! -f analyze.py ]; then
  say "找不到程序本体（analyze.py）。
请把「启动.app」放回 race-gopro 文件夹里，再双击它。"
  exit 1
fi

if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
  say "没找到项目自带的运行环境 .venv，先用系统的 python3 试试。
依赖可能不全。要装的话，在仓库目录里执行：
python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
else
  say "没找到 Python。
先装一个：https://www.python.org/downloads/
装完在仓库目录里执行：
python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  say "没找到 ffmpeg —— 读视频、出片都要靠它。
在终端里执行一次：brew install ffmpeg

（如果确实装了：在终端里跑 which ffmpeg 看它在哪个目录，
再把那个目录加进启动脚本里的 PATH，或装到 /opt/homebrew/bin。）"
  exit 1
fi

{
  echo "解释器：  $PY"
  echo "ffmpeg：  $(command -v ffmpeg)"
  echo "PATH（修补后）：$PATH"
} >>"$log"

# 标准输出同时进日志（网页上的进度也是从同一份来的）
"$PY" -m rapp.app "$@" >>"$log" 2>&1
code=$?

if [ "$code" -eq 0 ]; then
  echo "正常退出（$code）" >>"$log"
  exit 0
fi

echo "异常退出（$code）" >>"$log"
say "程序退出了（退出码 $code）。
具体原因写在日志里：
$log

（.race-gopro.log 是隐藏文件，在 Finder 里按 ⌘⇧. 才能看到；
也可以复制上面这个路径，用「前往文件夹」⌘⇧G 粘进去。）"
exit "$code"
