# 本地环境
.venv/

# 输出（视频、图表、看板都可以随时重新生成）
out/
*_out/

# 用户上传的素材（原始视频、官方圈速表 / 赛道图……属于个人资料，不进仓库）
video/

# GoPro 素材（体积大，放哪都不进仓库）
*.MP4
*.mp4

# macOS
.DS_Store

# VS Code：settings.json 里没有机器相关路径，保留共享（方便换机器后仍有同样的工作区配置）；
# 但下面这几个常带本地绝对路径（解释器路径、本地调试 / 任务配置），一律不进仓库
.vscode/launch.json
.vscode/tasks.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# 网页应用记的"最近打开过的视频"—— 是别人机器上的路径，别带进仓库
.race-gopro-recent.json

# 双击启动那个 app 写的运行日志
.race-gopro.log
# 打包成独立应用的产物与中间文件
# （packaging/ffmpeg/ 是下下来的静态 ffmpeg，200 MB，绝对不能进仓库）
dist/
build/
packaging/ffmpeg/
packaging/cache/
packaging/matplotlib/